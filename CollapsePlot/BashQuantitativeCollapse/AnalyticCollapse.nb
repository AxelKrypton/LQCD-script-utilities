                RowBox[{"xRange", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"xRange", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "We", " ", "are", " ", "now", " ", "ready", " ", "to", " ", 
             "perform", " ", "the", " ", 
             RowBox[{"integration", ".", " ", "Here"}], " ", "we", " ", 
             "will", " ", "need", " ", "a", " ", "small", " ", "further", " ",
              "error", " ", "propagation", " ", "when", " ", "we", 
             "\[IndentingNewLine]", "divide", " ", "by", " ", "the", " ", 
             "integration", " ", "interval", " ", "width", " ", "and", " ", 
             "we", " ", "take", " ", "the", " ", "square", " ", 
             RowBox[{"root", ".", "\[IndentingNewLine]", "d"}]}], "=", 
            RowBox[{
             RowBox[{"sqrt", 
              RowBox[{"(", 
               RowBox[{"I", "/", "a"}], ")"}]}], " ", "=", 
             RowBox[{
              RowBox[{">", " ", "sigma_d"}], "=", 
              RowBox[{"sigma_I", "/", 
               RowBox[{"(", 
                RowBox[{"2", "*", "sqrt", 
                 RowBox[{"(", 
                  RowBox[{"a", "*", "I"}], ")"}]}], ")"}]}]}]}]}], 
           "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"collapseQuality", "=", 
           RowBox[{"{", 
            RowBox[{"bC", ",", "nu", ",", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"kDistanceSquared", "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"xRange", "[", 
