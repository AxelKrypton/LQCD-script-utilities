                 RowBox[{"k1", "[", "x", "]"}], "-", 
                 RowBox[{"k2", "[", "x", "]"}]}], ")"}], "^", "2"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", 
                RowBox[{"xRange", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
