                  RowBox[{"xRange", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "-", 
                  RowBox[{"xRange", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "*", 
                "kDistanceSquared"}], "]"}]}]}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
