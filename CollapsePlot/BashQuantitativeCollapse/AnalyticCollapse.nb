                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"de_h", "/", "de_f"}], ")"}], "^", "2"}], "*", 
                 RowBox[{"sigma_f", "^", "2"}]}], "+", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"de_h", "/", "de_g"}], ")"}], "^", "2"}], "*", 
                 RowBox[{"sigma_g", "^", "2"}]}]}], "]"}], "\n", 
              "                      ", "=", 
              RowBox[{
               RowBox[{"2", "*"}], "|", 
               RowBox[{"f", "-", "g"}], "|", 
               RowBox[{"*", "sqrt", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"sigma_f", "^", "2"}], "+", 
                  RowBox[{"sigma_g", "^", "2"}]}], ")"}]}]}]}]}]}], 
           "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"kDistanceSquared", "=", 
           RowBox[{"N", "[", 
            RowBox[{"Integrate", "[", 
