   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"data1", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ">=", 
         RowBox[{"data2", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", 
        RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"collapseQualityScan", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"xRange", "=", 
           RowBox[{"xRangeCalc", "[", 
            RowBox[{"data1", ",", "data2", ",", "bC", ",", "nu"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Here", " ", "the", " ", "data", " ", "are", " ", "reorganised", 
            " ", "for", " ", "the", " ", "interpolation", " ", "and", " ", 
            "they", " ", "are", " ", "interpolated"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"k1", "=", 
           RowBox[{"Interpolation", "[", 
            RowBox[{"kurtosis", "[", 
             RowBox[{"data1", ",", "bC", ",", "nu"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"k2", "=", 
           RowBox[{"Interpolation", "[", 
            RowBox[{"kurtosis", "[", 
             RowBox[{"data2", ",", "bC", ",", "nu"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"kErr1", "=", 
           RowBox[{"Interpolation", "[", 
            RowBox[{"kurtosisError", "[", 
             RowBox[{"data1", ",", "bC", ",", "nu"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"kErr2", "=", 
           RowBox[{"Interpolation", "[", 
            RowBox[{"kurtosisError", "[", 
             RowBox[{"data2", ",", "bC", ",", "nu"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "Now", " ", "the", " ", "distance", " ", "can", " ", "be", " ", 
             "calculated", " ", "and", " ", "the", " ", "error", " ", "on", 
             " ", "it", " ", "as", " ", "well", " ", "propagating", 
             "\[IndentingNewLine]", "ERROR", " ", 
             RowBox[{"PROPAGATION", ":", " ", "h"}]}], "=", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"f", "-", "g"}], ")"}], "^", "2"}], "\n", 
