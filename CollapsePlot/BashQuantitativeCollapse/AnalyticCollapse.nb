                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"kDistanceErrSquared", "=", 
           RowBox[{"N", "[", 
            RowBox[{"Integrate", "[", 
             RowBox[{
              RowBox[{"2", "*", 
